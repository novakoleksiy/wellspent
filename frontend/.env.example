VITE_API_BASE_URL=http://localhost:8000
# Conference demo mode: auto-logs into the shared demo account (no login screen)
# and hides sign-out. Set to "true" only on the demo deployment.
VITE_DEMO_MODE=false
# Demo link guard: blocks outbound/external links so kiosk attendees can't
# navigate away. Defaults to VITE_DEMO_MODE when unset; set explicitly to
# "true"/"false" to toggle independently of demo mode.
# VITE_DEMO_LINK_GUARD=true
