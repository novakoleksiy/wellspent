DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wellspent
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MY_SWISS_TOURISM_API=replace-me
# Optional: enables the LLM day planner; leave unset to use the deterministic planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PLANNER_TEMPERATURE=0.9
OPENAI_PLANNER_TIMEOUT_SECONDS=12.0
REGISTRATION_OPEN=false
# Per-IP rate limiting on demo/recommend/swiss endpoints. Keep true in prod.
RATE_LIMIT_ENABLED=true
# Trusted reverse-proxy hops in front of the app (Render's edge = 1). Used to
# read the real client IP from X-Forwarded-For without trusting spoofed entries.
TRUSTED_PROXY_HOPS=1
# Conference demo mode: exposes POST /api/demo/session (credential-free login)
# for a shared demo user. Seed the user + trips out-of-band with
# `python -m scripts.seed_demo`. Keep false in prod.
DEMO_MODE=false
DEMO_USER_EMAIL=demo@wellspent.world
DEMO_USER_NAME=Demo Explorer
# Optional: leave blank and the seed script generates a random strong password.
# Set only if you want to log into the demo account via the normal /login form.
DEMO_USER_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
