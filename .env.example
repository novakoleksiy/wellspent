DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wellspent
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MY_SWISS_TOURISM_API=replace-me
# Optional: enables the LLM day planner; leave unset to use the deterministic planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PLANNER_TEMPERATURE=0.9
OPENAI_PLANNER_TIMEOUT_SECONDS=12.0
REGISTRATION_OPEN=false
# Per-IP rate limiting on demo/recommend/swiss endpoints. Keep true in prod.
RATE_LIMIT_ENABLED=true
# Conference demo mode: exposes POST /api/demo/session (credential-free login)
# and seeds a shared demo user + sample trips on startup. Keep false in prod.
DEMO_MODE=false
DEMO_USER_EMAIL=demo@wellspent.world
DEMO_USER_NAME=Demo Explorer
DEMO_USER_PASSWORD=wellspent-demo
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
